# Snowflake connection for the LakeLogic RideFlow demo deploy.
# Copy to `.env` (gitignored) and fill in. The deploy + lakelogic engine read these.
SNOWFLAKE_ACCOUNT=your_org-your_account      # account identifier (e.g. ab12345 or org-account)
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password             # or use key-pair (see README)
SNOWFLAKE_ROLE=ACCOUNTADMIN                  # a role that can CREATE DATABASE + WAREHOUSE
SNOWFLAKE_WAREHOUSE=RIDEFLOW_WH              # existing warehouse, or the deploy creates it
SNOWFLAKE_DATABASE=RIDEFLOW_DEV_DEMO         # the deploy creates this database

# ── Native Snowflake Project (deploy/deploy_project.py) ──────────────────────
# Git-connected Workspace + Notebooks + Task DAG. Only needed for deploy_project.py.
SNOWFLAKE_COMPUTE_POOL=RIDEFLOW_POOL         # created if missing; runs the notebooks
GITHUB_REPO_URL=https://github.com/<owner>/<repo>   # the private repo Snowflake reads
GITHUB_USER=<github username>                # username paired with the PAT
GITHUB_PAT=<fine-grained PAT, repo:read>     # Snowflake authenticates to GitHub with this
