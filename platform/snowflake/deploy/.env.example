# Snowflake connection for deploy/deploy_project.py.
# Copy to `.env` (gitignored) and fill in. Nothing here is committed with values.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=                          # or SNOWFLAKE_PRIVATE_KEY_PATH (+ _PASSPHRASE)
SNOWFLAKE_ROLE=                              # a role that can create a database, warehouse, pool and tasks
# Object names default to deploy/project.json (generated from the project name); set to override.
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_COMPUTE_POOL=

# The Git repository Snowflake reads this project from.
GITHUB_REPO_URL=                             # https://github.com/<owner>/<repo>
GITHUB_USER=                                 # only for a private repo
GITHUB_PAT=                                  # only for a private repo (repo:read)
